{
  "name": "@hpcc-js/wasm-wit-bindgen",
  "version": "1.0.0",
  "description": "hpcc-js - WASM wit-bindgen",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "types/**/*"
  ],
  "scripts": {
    "clean": "rimraf coverage dist dist-test types .nyc_output src-rs/target",
    "build-rs": "bash scripts/build-rs.sh",
    "build-rs-dev": "bash scripts/build-rs.sh --dev",
    "gen-types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "gen-types-watch": "npm run gen-types -- --watch",
    "bundle": "node esbuild.js",
    "bundle-dev": "npm run bundle -- --development",
    "bundle-watch": "npm run bundle-dev -- --watch",
    "build-dev": "run-p gen-types bundle-dev",
    "build": "run-p gen-types bundle",
    "lint-skypack": "npx -y @skypack/package-check",
    "lint-eslint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "run-p lint-eslint",
    "test-rs": "cargo test --manifest-path src-rs/Cargo.toml",
    "test-browser": "vitest run --project browser",
    "test-node": "vitest run --project node",
    "test": "run-s test-rs test-vitest",
    "test-vitest": "vitest run",
    "coverage": "vitest run --coverage",
    "update-npm": "npx -y npm-check-updates -u -t minor",
    "update-npm-major": "npx -y npm-check-updates -u",
    "update-rs": "cd src-rs && cargo update && (command -v cargo-upgrade >/dev/null 2>&1 || cargo install cargo-edit) && cargo upgrade && cd .. && bash scripts/update-versions.sh",
    "update-rs-major": "cd src-rs && cargo update && (command -v cargo-upgrade >/dev/null 2>&1 || cargo install cargo-edit) && cargo upgrade --incompatible && cd .. && bash scripts/update-versions.sh",
    "update": "run-s update-npm update-rs",
    "update-major": "run-s update-npm-major update-rs-major"
  },
  "dependencies": {},
  "peerDependencies": {
    "@bytecodealliance/jco": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@bytecodealliance/jco": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.42.0",
    "@hpcc-js/esbuild-plugins": "1.13.2"
  },
  "keywords": [
    "wit",
    "wit-bindgen",
    "component-model",
    "typescript",
    "webassembly",
    "wasm"
  ],
  "author": "hpcc-systems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hpcc-systems/hpcc-js-wasm.git"
  },
  "homepage": "https://hpcc-systems.github.io/hpcc-js-wasm/",
  "license": "Apache-2.0"
}
